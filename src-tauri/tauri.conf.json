{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quest Rig",
  "version": "0.5.0",
  "identifier": "com.questrig.app",
  "mainBinaryName": "quest-rig",
  "build": {
    "beforeDevCommand": "npm run host && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run host:fresh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quest Rig",
        "width": 1320,
        "height": 800,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true,
        "languages": ["English", "Russian"]
      }
    },
    "resources": {
      "binaries/game_host.exe": "game_host.exe"
    }
  }
}
